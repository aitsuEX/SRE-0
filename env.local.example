# ── Required: Agora credentials ─────────────────────────
# Found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# ── Optional: MCP Server URL ─────────────────────────────
# URL where your SRE-Zero MCP tools are accessible.
# Leave blank to run the agent WITHOUT MCP tools.
# For local dev with ngrok: https://your-ngrok-url/api/mcp
# IMPORTANT: Agora's cloud cannot reach http://localhost — use ngrok
MCP_SERVER_URL=

# ── Incident Configuration ───────────────────────────────
# Replace these with your actual URLs
INCIDENT_NAME=Set your incident name
INCIDENT_WEBSITE_URL=
INCIDENT_GITHUB_REPO_URL=
INCIDENT_TESTSPRITE_URL=
INCIDENT_JIRA_URL=
# Required alongside INCIDENT_JIRA_URL for real Jira issue creation/retrieval:
INCIDENT_JIRA_PROJECT_KEY=
INCIDENT_JIRA_EMAIL=
INCIDENT_JIRA_API_TOKEN=
INCIDENT_MONITORING_URL=

# ── PagerDuty (optional) ─────────────────────────────────
# Leave blank to leave PagerDuty inactive (adapter returns NOT_CONFIGURED honestly).
PAGERDUTY_API_TOKEN=
PAGERDUTY_SERVICE_ID=
PAGERDUTY_API_BASE_URL=https://api.pagerduty.com

# ── Optional: BYOK (Bring Your Own Keys) ────────────────
# If you want to use your own LLM/STT/TTS instead of Agora-managed:
# NEXT_LLM_API_KEY=
# NEXT_LLM_URL=
# NEXT_DEEPGRAM_API_KEY=
# NEXT_ELEVENLABS_API_KEY=
INCIDENT_ID=INC-2026-001
INCIDENT_SEVERITY=SEV-1
INCIDENT_DESCRIPTION=Users are experiencing payment failures.
INCIDENT_GITHUB_BRANCH=main
INCIDENT_MONITORING_SERVICE=payment-service
SRE_ZERO_ALLOW_DESTRUCTIVE_ACTIONS=false
MCP_AUTH_TOKEN=
